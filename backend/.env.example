# OdyssMedic Backend Environment Configuration
# For permanent user persistence on Vercel Serverless, configure DATABASE_URL
# using a managed PostgreSQL database (Supabase or Neon free/pro tier).
# Example (Neon / Supabase):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

DATABASE_URL=
SECRET_KEY=replace-with-openssl-rand-hex-32
CORS_ORIGINS=https://odyssmedic.vercel.app
